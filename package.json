{
  "name": "event-managment-api",
  "version": "0.1.0",
  "description": "Ehitad selle rakenduse ise, samm-sammult.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "server": "tsx --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kee5n/event-managment.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/kee5n/event-managment/issues"
  },
  "homepage": "https://github.com/kee5n/event-managment#readme",
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
