{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "overrides": [
    {
      "files": ["src/config/env.ts", "src/scripts/**"],
      "rules": { "no-console": "off" }
    }
  ],
  "env": {
    "builtin": true
  }
}
